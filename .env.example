# MEDIXO AI — Configurable Environment Variables
# Copy this file to .env and populate official endpoints/channels for production.

# Official public origin for canonical URLs and absolute social preview image URLs
VITE_CANONICAL_URL=

# Project Inquiry Backend Endpoint (POST JSON)
VITE_INQUIRY_API_URL=
VITE_INQUIRY_API_KEY=

# Official Business Contact Channels
VITE_CONTACT_EMAIL=
VITE_CONTACT_PHONE=
VITE_LINKEDIN_URL=
VITE_COMPANY_ADDRESS=
VITE_GITHUB_URL=
VITE_SOCIAL_X_URL=

# Optional Public Project Deployment Links
VITE_PROJECT_PRATIKSHYA_URL=
VITE_PROJECT_SWARNOVA_URL=
VITE_PROJECT_EDUX_URL=
VITE_PROJECT_HEALTHCARE_URL=

# Optional verified product screenshots (URL or path from public/, e.g. /images/project-screen.webp)
VITE_PROJECT_PRATIKSHYA_SCREENSHOT=
VITE_PROJECT_SWARNOVA_SCREENSHOT=
VITE_PROJECT_EDUX_SCREENSHOT=
VITE_PROJECT_HEALTHCARE_SCREENSHOT=
